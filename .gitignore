# Build output (backend/ and giftme-frontend/ have their own; this catches anything
# run from the repo root by mistake, e.g. `mvn` invoked outside backend/).
target/
dist/
node_modules/

# Claude Code local session state - machine-specific, not shared.
.claude/

# Env files
.env
.env.local

# Logs
*.log

# Editor / OS
.idea/
.vscode/
*.iml
*.swp
.DS_Store

# Design sources kept on disk but never committed: multi-megabyte PNG masters
# and camera-roll originals under UUID filenames. The shipped logo is the
# lossless WebP re-encode (giftme-frontend/src/assets/images/brand-logo.webp);
# see that folder's README.md. Committing these made `git push` time out.
giftme-frontend/src/assets/images/[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]-*.png
giftme-frontend/src/assets/images/brand-logo-master.png
*\ copie.*
*\ copy.*
