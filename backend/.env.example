# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_NAME=giftme
DATABASE_USERNAME=giftme
DATABASE_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://localhost:5432/giftme

# --- JWT --- generate a strong secret, e.g.: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=1209600000

# --- File storage (local dev/single-instance deployments) ---
FILE_STORAGE_PATH=./storage/uploads
FILE_STORAGE_PUBLIC_URL=/uploads

# --- CORS: comma-separated list of allowed origins ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Public-facing app URL, used to build memory page links (https://giftme.ma/m/{code}) ---
PUBLIC_APP_URL=https://giftme.ma

SERVER_PORT=8080
